<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/Logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets async="true">
    <target xsi:type="File"
            name="appInfoFile"
            fileName="${basedir}/Logs/Applog.Info.log"
            layout="${longdate:universalTime=true}|INFO|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}${newline}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <target xsi:type="File"
            name="appDebugFile"
            fileName="${basedir}/Logs/Applog.Debug.log"
            layout="${longdate:universalTime=true}|DEBUG|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}${newline}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <target xsi:type="File"
            name="appWarnFile"
            fileName="${basedir}/Logs/Applog.Warn.log"
            layout="${longdate:universalTime=true}|WARN|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}${newline}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <target xsi:type="File"
            name="appErrorFile"
            fileName="${basedir}/Logs/Applog.Error.log"
            layout="${longdate:universalTime=true}|ERROR|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}${newline}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <target xsi:type="File"
            name="subscriptionInfoFile"
            fileName="${basedir}/Logs/SubscriptionLog.Info.log"
            layout="${longdate:universalTime=true}|INFO|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}${newline}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <target xsi:type="File"
            name="subscriptionDebugFile"
            fileName="${basedir}/Logs/SubscriptionLog.Debug.log"
            layout="${longdate:universalTime=true}|DEBUG|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}${newline}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <target xsi:type="File"
            name="subscriptionWarnFile"
            fileName="${basedir}/Logs/SubscriptionLog.Warn.log"
            layout="${longdate:universalTime=true}|WARN|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}${newline}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <target xsi:type="File"
            name="subscriptionErrorFile"
            fileName="${basedir}/Logs/SubscriptionLog.Error.log"
            layout="${longdate:universalTime=true}|ERROR|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}${newline}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <target xsi:type="Console" name="console" layout="${longdate:universalTime=true}|${level:uppercase=true}|${logger}|RequestId=${scopeproperty:item=RequestId}|UserId=${scopeproperty:item=UserId}|${message}${onexception:${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Subscription controller and embedded subscription project logs. -->
    <logger name="*Subscription*" minlevel="Debug" maxlevel="Debug" writeTo="subscriptionDebugFile,console" final="true" />
    <logger name="SubscriptionPlatform.*" minlevel="Debug" maxlevel="Debug" writeTo="subscriptionDebugFile,console" final="true" />
    <logger name="*Subscription*" minlevel="Info" maxlevel="Info" writeTo="subscriptionInfoFile,console" final="true" />
    <logger name="SubscriptionPlatform.*" minlevel="Info" maxlevel="Info" writeTo="subscriptionInfoFile,console" final="true" />
    <logger name="*Subscription*" minlevel="Warn" maxlevel="Warn" writeTo="subscriptionWarnFile,console" final="true" />
    <logger name="SubscriptionPlatform.*" minlevel="Warn" maxlevel="Warn" writeTo="subscriptionWarnFile,console" final="true" />
    <logger name="*Subscription*" minlevel="Error" writeTo="subscriptionErrorFile,console" final="true" />
    <logger name="SubscriptionPlatform.*" minlevel="Error" writeTo="subscriptionErrorFile,console" final="true" />

    <!-- All other application logs. -->
    <logger name="*" minlevel="Debug" maxlevel="Debug" writeTo="appDebugFile,console" />
    <logger name="*" minlevel="Info" maxlevel="Info" writeTo="appInfoFile,console" />
    <logger name="*" minlevel="Warn" maxlevel="Warn" writeTo="appWarnFile,console" />
    <logger name="*" minlevel="Error" writeTo="appErrorFile,console" />
  </rules>
</nlog>
